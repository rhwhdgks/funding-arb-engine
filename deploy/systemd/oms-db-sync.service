[Unit]
Description=Funding Fee OMS DB Sync Loop
After=network.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/funding-fee
EnvironmentFile=/opt/funding-fee/.env
ExecStart=/bin/bash /opt/funding-fee/scripts/runtime/run_db_sync_loop.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
