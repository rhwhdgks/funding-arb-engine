# Copy to market_data_collector/.env.collector and fill DB values.
#
# This env is intentionally market-data only:
# - writes symbol_price
# - writes funding_rate
# - does not need exchange private API keys
# - does not control strategy orders / hedge / close

ENABLE_DB_PERSISTENCE=1
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=trader
MARIADB_PASSWORD=
MARIADB_DATABASE=trading_dev

# Collector ownership label. Keep this distinct from strategy if needed.
STRATEGY_ACCOUNT_LABEL=market_data
STRATEGY_LOGIC="funding fee"

# Public market data universe. Strategy can stay much smaller.
SYMBOL_PRICE_EXCHANGES=binance,okx,hyperliquid
SYMBOL_PRICE_SYMBOLS=BTC,ETH,XRP,BNB,SOL,TRX,DOGE,AAVE,ADA,BCH,ATOM,LINK,OP,XLM,DOT,LTC,AVAX,HBAR,SUI

# One DB bucket per minute by default.
SYMBOL_PRICE_INTERVAL_SEC=60
SYMBOL_PRICE_BUCKET_SEC=60
SYMBOL_PRICE_IMPACT_NOTIONAL_USD=20000
SYMBOL_PRICE_WS_FIRST=1
SYMBOL_PRICE_WS_STALE_SEC=15

# Funding is collected by the same collector process.
SYMBOL_PRICE_FUNDING_INTERVAL_SEC=300
