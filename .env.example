# Copy to .env and fill only the values you need.

# DB persistence is explicit opt-in. Keep 0 for DB-less strategy/report runs.
ENABLE_DB_PERSISTENCE=0
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=trading_dev

STRATEGY_ACCOUNT_LABEL=real
STRATEGY_LOGIC=funding fee
STRATEGY_EXCHANGES=binance,okx
STRATEGY_ALLOWED_PAIRS=binance-okx
STRATEGY_SYMBOLS=ETH,SOL,XRP,DOGE
STRATEGY_RUN_DURATION=12h

# Normal close fee gate. Keep disabled unless you intentionally defer normal closes by fee/net PnL.
STRATEGY_NORMAL_CLOSE_FEE_GATE_ENABLED=0
STRATEGY_NORMAL_CLOSE_FEE_GATE_MIN_NET_USD=0.0
STRATEGY_NORMAL_CLOSE_FEE_GATE_MAX_DEFER_SEC=600

# Ops Console defaults. Keep host local-only unless you add VPN/tunnel + token.
ENABLE_WEB_TRADING=0
OPS_CONSOLE_HOST=127.0.0.1
OPS_CONSOLE_PORT=8010
OPS_CONSOLE_ACTION_TOKEN_REQUIRED=0
OPS_CONSOLE_ACTION_TOKEN=

# Fill exchange credentials only in your private .env.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
