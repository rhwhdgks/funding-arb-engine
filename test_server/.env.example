# Copy to test_server/.env for test-server runs.

# DB persistence is explicit opt-in. Keep 0 to run without DB writes.
ENABLE_DB_PERSISTENCE=0
MARIADB_HOST=
MARIADB_PORT=3306
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_DATABASE=trading_dev

STRATEGY_TEST_ENV=1
STRATEGY_ACCOUNT_LABEL=test
STRATEGY_LOGIC="funding fee"
STRATEGY_EXCHANGES=binance,okx
STRATEGY_ALLOWED_PAIRS=binance-okx
STRATEGY_SYMBOLS=ETH,SOL,XRP,DOGE
STRATEGY_RUN_DURATION=30m

# Funding source. Keep runtime for DB-less runs; use symbol_price when the market_data_collector is writing funding columns.
STRATEGY_FUNDING_SOURCE=runtime
STRATEGY_FUNDING_MAX_AGE_SEC=900
STRATEGY_FUNDING_EVENT_MODEL_ENABLED=0
STRATEGY_FUNDING_EVENT_ENTRY_BUFFER_SEC=5
STRATEGY_CLOSE_POSITIVE_FUNDING_WAIT_ENABLED=0
STRATEGY_CLOSE_POSITIVE_FUNDING_WAIT_MAX_SEC=1800
STRATEGY_COLLECTOR_FUNDING_REFRESH_SEC=60
STRATEGY_FUNDING_CASHFLOW_ENABLED=1
STRATEGY_FUNDING_CASHFLOW_INTERVAL_SEC=300
STRATEGY_MAKER_ENGINE_REQUIRE_FULL_ADMISSION=1

# Durable order truth and low-frequency full open-order discovery.
STRATEGY_ORDER_INTENT_JOURNAL=test_server/runtime/order_intents.jsonl
STRATEGY_ORDER_INTENT_FSYNC=1
STRATEGY_ORDER_INTENT_UNKNOWN_GRACE_SEC=30
BINANCE_OPEN_ORDERS_FULL_RECONCILE_SEC=120

# Normal close fee gate. Test with 1 before enabling in real-server runs.
STRATEGY_NORMAL_CLOSE_FEE_GATE_ENABLED=0
STRATEGY_NORMAL_CLOSE_FEE_GATE_MIN_NET_USD=0.0
STRATEGY_NORMAL_CLOSE_FEE_GATE_MAX_DEFER_SEC=600

STRATEGY_LIVE_LOG_DIR=test_server/logs
STRATEGY_LIVE_STDOUT_LOG=test_server/logs/strategy_live.out
STRATEGY_LIVE_EVENT_LOG_PATH=test_server/logs/strategy_live.jsonl
STRATEGY_LIVE_RUN_META_FILE=test_server/logs/strategy_live.run.json
STRATEGY_LIVE_PID_FILE=test_server/logs/strategy_live.pid
STRATEGY_LIVE_LOCK_FILE=test_server/logs/strategy_live.lock

# Ops Console defaults. Enable trading only when deliberately testing console orders.
ENABLE_WEB_TRADING=0
OPS_CONSOLE_HOST=127.0.0.1
OPS_CONSOLE_PORT=8010
OPS_CONSOLE_STALE_MS=30000
OPS_CONSOLE_ACTION_TOKEN_REQUIRED=1
OPS_CONSOLE_ACTION_TOKEN=
OPS_CONSOLE_LIVE_ACTION_WINDOW_SEC=300
OPS_CONSOLE_LIVE_ACTION_WINDOW_MAX_SEC=900
OPS_CONSOLE_ALLOWED_ORIGINS=http://127.0.0.1:8010,http://localhost:8010

# Fill exchange test credentials only in your private test_server/.env.
BINANCE_ACCESS_KEY=
BINANCE_SECRET_KEY=
OKX_ACCESS_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
